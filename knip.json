{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["src/main.tsx"],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": ["postcss.config.mjs"],
  "ignoreFiles": ["src/app/components/ui/**"],
  "rules": {
    "files": "error",
    "exports": "off",
    "types": "off",
    "dependencies": "off",
    "duplicates": "off",
    "unlisted": "off",
    "binaries": "off"
  }
}
